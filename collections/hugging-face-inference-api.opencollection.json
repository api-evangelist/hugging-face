              {
                "name": "model_id",
                "value": "stabilityai/stable-diffusion-xl-base-1.0",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate an image from a text prompt using a diffusion model."
        }
      ]
    }
  ],
  "bundled": true
}