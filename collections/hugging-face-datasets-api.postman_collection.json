          "name": "List Datasets on the Hub",
          "request": {
            "name": "List Datasets on the Hub",
            "description": {
              "content": "List and search datasets hosted on the Hugging Face Hub. Supports filtering by author, tags, and full-text search.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Full-text search query to filter datasets"
                },
                {
                  "disabled": false,
                  "key": "author",
                  "value": "<string>",
                  "description": "Filter by dataset author or organization"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Filter by tags (comma-separated)"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Property to sort results by"
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "<string>",
                  "description": "Sort direction"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "30",
                  "description": "Number of results to return"
                },
                {
                  "disabled": false,
                  "key": "full",
                  "value": "false",
                  "description": "Whether to return full dataset information"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
